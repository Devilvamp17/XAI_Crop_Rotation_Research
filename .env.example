# Core services
MODEL_API_BASE_URL=http://127.0.0.1:8000

# Free/public API endpoints
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=xai-crop-rotation-research/1.0 (contact: local-dev)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Optional API keys for external data providers
GEOCODE_API_KEY=
WEATHER_API_KEY=
SOIL_API_KEY=

# LLM Provider
LLM_PROVIDER=openrouter
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_TIMEOUT_SECONDS=180

# OpenAI-compatible provider (optional)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_X_TITLE=xai-crop-rotation-research
